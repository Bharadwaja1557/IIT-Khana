# Copy to .env and fill in. .env is gitignored.

# --- Data source (campusmess.in public REST API) ---
CAMPUSMESS_API_BASE=https://campusmess.in/api
# IIT Kanpur. Discovered in Phase 0 recon; all 14 halls share this id.
INSTITUTION_ID=66685367-54c2-4650-8ef5-0584e80efcb9

# Politeness settings for ingestion. Do not lower the delay.
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_USER_AGENT=IIT-Khana/0.1 (student project; contact <your-email>)

# --- Local storage ---
DB_PATH=db/khana.db
RAW_CACHE_DIR=data/raw

# --- LLM (query routing / NL->SQL and answer synthesis) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
